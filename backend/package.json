{
  "name": "kingsraid-planner-backend",
  "version": "1.0.0",
  "description": "Backend API pour Kings Raid Planner avec MongoDB",
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "import-heroes": "node scripts/importHeroes.js",
    "import-artifacts": "node scripts/importArtifacts.js",
    "import-gearsets": "node scripts/importGearSets.js",
    "import-perks": "node scripts/importPerks.js",
    "import-hero-perks": "node scripts/importHeroPerks.js",
    "import-all": "npm run import-heroes && npm run import-artifacts && npm run import-gearsets && npm run import-perks && npm run import-hero-perks",
    "verify-heroes": "node scripts/verifyHeroes.js",
    "verify-data": "node scripts/verifyData.js",
    "clear-db": "node scripts/clearDatabase.js",
    "backup-db": "node scripts/backupDatabase.js",
    "test-api": "node scripts/testAPI.js",
    "test-mongo": "node scripts/testMongoConnection.js",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.9.6",
    "mongoose-paginate-v2": "^1.9.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "kings-raid",
    "planner",
    "mongodb",
    "api",
    "gaming"
  ],
  "author": "Votre Nom",
  "license": "MIT"
}
